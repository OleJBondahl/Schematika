[importlinter]
root_packages =
    schematika

[importlinter:contract:electrical-not-project]
name = electrical must not import from project
type = forbidden
source_modules =
    schematika.electrical
forbidden_modules =
    schematika.project

[importlinter:contract:pcb-not-project]
name = pcb must not import from project
type = forbidden
source_modules =
    schematika.pcb
forbidden_modules =
    schematika.project

[importlinter:contract:overview-leaf]
name = overview is a leaf — nothing in core or other domains imports from it
type = forbidden
source_modules =
    schematika.core
    schematika.electrical
    schematika.pcb
    schematika.cable
    schematika.pid
forbidden_modules =
    schematika.overview
