[importlinter]
root_packages =
    schematika

[importlinter:contract:electrical-not-project]
name = electrical must not import from project
type = forbidden
source_modules =
    schematika.electrical
forbidden_modules =
    schematika.project

[importlinter:contract:pcb-not-project]
name = pcb must not import from project
type = forbidden
source_modules =
    schematika.pcb
forbidden_modules =
    schematika.project

[importlinter:contract:catalog-is-layer1-pure]
name = catalog must not import core, domains, or project
type = forbidden
source_modules =
    schematika.catalog
forbidden_modules =
    schematika.core
    schematika.electrical
    schematika.pcb
    schematika.pid
    schematika.cable
    schematika.block
    schematika.project
    schematika.rendering
    schematika.mcp

[importlinter:contract:overview-layer]
name = overview must not import domains or project
type = forbidden
source_modules =
    schematika.overview
forbidden_modules =
    schematika.electrical
    schematika.pcb
    schematika.pid
    schematika.cable
    schematika.block
    schematika.project
